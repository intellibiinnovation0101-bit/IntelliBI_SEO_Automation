# =============================================================================
#  IntelliBI SEO Walk-In Automation — .gitignore
#  Keeps SECRETS and machine-local artifacts out of version control.
# =============================================================================

# ── secrets & credentials (NEVER commit) ─────────────────────────────────────
credentials/*.json
credentials/*.py
!credentials/*.example.*

# ── runtime working folders / generated output ───────────────────────────────
logs/
output/
temp/
cache/
*.xlsx

# ── python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
env/
.ipynb_checkpoints/

# ── local backups (never commit) ─────────────────────────────────────────────
*.bak
*.bak_*
*_to_delete/

# ── OS / editor cruft ────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
~$*
